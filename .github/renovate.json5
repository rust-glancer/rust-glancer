{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'config:recommended',
        'helpers:pinGitHubActionDigests',
        ':configMigration',
    ],
    dependencyDashboard: {
        enabled: true,
    },
    ignorePaths: [
        '**/node_modules/**',
        '**/bower_components/**',
        'crates/lib/test-fixture/assets/fake_sysroot/**',
        'test_targets/**',
    ],
    labels: [
        'dependencies',
    ],
    timezone: 'UTC',
    schedule: [
        '* 0-5 * * 0',
    ],
    updateNotScheduled: false,
    prHourlyLimit: 2,
    prConcurrentLimit: 5,
    minimumReleaseAge: '7 days',
    internalChecksFilter: 'strict',
    prCreation: 'not-pending',
    rangeStrategy: 'bump',
    rebaseWhen: 'behind-base-branch',
    lockFileMaintenance: {
        enabled: true,
        schedule: [
            '* 0-5 * * 0',
        ],
        automerge: false,
    },
    packageRules: [
        {
            description: 'Do not update Cargo git dependencies pinned to refs/tags',
            matchManagers: [
                'cargo',
            ],
            matchDatasources: [
                'git-refs',
                'git-tags',
                'github-tags',
                'gitlab-tags',
            ],
            enabled: false,
        },
        {
            description: 'Do not update rust-analyzer snapshot crates independently',
            matchManagers: [
                'cargo',
            ],
            matchDepNames: [
                'edition',
                'ra-ap-rustc_lexer',
                'rustc-literal-escaper',
                'rustc_apfloat',
                'stdx',
                'test-utils',
            ],
            enabled: false,
        },
        {
            description: 'Group non-major Rust dependencies',
            matchManagers: [
                'cargo',
            ],
            matchUpdateTypes: [
                'minor',
                'patch',
            ],
            groupName: 'rust dependencies',
        },
        {
            description: 'Group non-major TypeScript/npm dependencies',
            matchManagers: [
                'npm',
            ],
            matchUpdateTypes: [
                'minor',
                'patch',
            ],
            groupName: 'typescript dependencies',
        },
        {
            description: 'Require manual handling for Prettier updates',
            matchManagers: [
                'npm',
            ],
            matchPackageNames: [
                'prettier',
            ],
            groupName: 'prettier',
            dependencyDashboardApproval: true,
        },
        {
            description: 'Do not run npm lockfile-only maintenance',
            matchManagers: [
                'npm',
            ],
            matchUpdateTypes: [
                'lockFileMaintenance',
            ],
            enabled: false,
        },
        {
            description: 'Group non-major GitHub Actions version and pin updates',
            matchManagers: [
                'github-actions',
            ],
            matchUpdateTypes: [
                'minor',
                'patch',
                'pinDigest',
            ],
            groupName: 'github-actions',
        },
        {
            description: 'Require manual handling for major updates',
            matchUpdateTypes: [
                'major',
            ],
            dependencyDashboardApproval: true,
        },
        {
            description: 'Automerge only GitHub Action digest pin refreshes',
            matchManagers: [
                'github-actions',
            ],
            matchUpdateTypes: [
                'digest',
            ],
            groupName: 'github-action digests',
            automerge: true,
        },
    ],
}
