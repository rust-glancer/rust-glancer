{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",

    // Start from Renovate's recommended behavior, then add two repository-wide
    // maintenance helpers: immutable GitHub Actions pins and future config migrations.
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests",
        ":configMigration"
    ],

    // Keep pending/skipped updates visible without forcing every major update to
    // open a PR immediately.
    "dependencyDashboard": true,

    // Renovate discovers package files directly, not through the Cargo workspace.
    // The test targets are intentionally fake/fixture projects with their own
    // lockfiles and pinned versions, so updating them would mostly create noise.
    "ignorePaths": [
        "**/node_modules/**",
        "**/bower_components/**",
        "crates/lib/test-fixture/assets/fake_sysroot/**",
        "test_targets/**"
    ],

    // Put dependency update PRs on a predictable weekly cadence and cap burstiness.
    "labels": [
        "dependencies"
    ],
    "timezone": "Asia/Dubai",
    "schedule": [
        "before 8am on monday"
    ],
    "prHourlyLimit": 2,
    "prConcurrentLimit": 5,

    // Only surface dependency PRs after Renovate's internal checks are no
    // longer pending. For minimumReleaseAge this means CI-visible PRs should
    // already be using updates that survived the waiting window.
    "minimumReleaseAge": "7 days",
    "internalChecksFilter": "strict",
    "prCreation": "not-pending",

    // Prefer updating manifest ranges instead of only refreshing lockfiles, so
    // accepted PRs leave dependency intent visible in Cargo.toml/package.json.
    "rangeStrategy": "bump",

    // Keep update branches testing against the current base branch. This burns
    // a little more CI, but stale dependency PRs are much harder to trust.
    "rebaseWhen": "behind-base-branch",

    // Some CI tools are installed from workflow strings rather than native
    // package manifests. Teach Renovate about the important ones so they stay
    // in the same dependency PRs as the libraries that require them.
    "customManagers": [
        {
            "customType": "regex",
            "description": "Update Rust CLI tools installed by CI",
            "managerFilePatterns": [
                "/^\\.github/workflows/.+\\.ya?ml$/"
            ],
            "matchStrings": [
                "tool: (?<depName>gungraun-runner)@(?<currentValue>[^\\s]+)"
            ],
            "datasourceTemplate": "crate",
            "versioningTemplate": "cargo"
        }
    ],

    // Refresh lockfiles weekly as a separate maintenance PR rather than mixing
    // transitive-only churn into direct dependency updates.
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
            "before 8am on monday"
        ],
        "automerge": false
    },

    "packageRules": [
        {
            "description": "Do not update Cargo git dependencies pinned to refs/tags",
            "matchManagers": [
                "cargo"
            ],
            "matchDatasources": [
                "git-refs",
                "git-tags",
                "github-tags",
                "gitlab-tags"
            ],
            "enabled": false
        },
        {
            // The vendored rust-analyzer crates are copied from one upstream
            // snapshot. Their support crates need to move with that snapshot,
            // not as ordinary independent dependency updates.
            "description": "Do not update rust-analyzer snapshot crates independently",
            "matchManagers": [
                "cargo"
            ],
            "matchDepNames": [
                "edition",
                "ra-ap-rustc_lexer",
                "rustc-literal-escaper",
                "rustc_apfloat",
                "stdx",
                "test-utils"
            ],
            "enabled": false
        },
        {
            "description": "Group non-major Rust dependencies",
            "matchManagers": [
                "cargo"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "rust dependencies"
        },
        {
            "description": "Group CI Rust tools with Rust dependencies",
            "matchManagers": [
                "custom.regex"
            ],
            "matchDepNames": [
                "gungraun-runner"
            ],
            "groupName": "rust dependencies"
        },
        {
            "description": "Group non-major TypeScript/npm dependencies",
            "matchManagers": [
                "npm"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "typescript dependencies"
        },
        {
            // Formatter updates often need source reformatting, and hosted
            // Renovate cannot safely run arbitrary format commands unless the
            // bot installation explicitly allows them.
            "description": "Require manual handling for Prettier updates",
            "matchManagers": [
                "npm"
            ],
            "matchPackageNames": [
                "prettier"
            ],
            "groupName": "prettier",
            "dependencyDashboardApproval": true
        },
        {
            // npm lockfile maintenance can silently float dev tools within
            // existing ranges. That is how Prettier changed formatting without
            // any package.json change, so keep npm lock refreshes tied to real
            // manifest updates instead.
            "description": "Do not run npm lockfile-only maintenance",
            "matchManagers": [
                "npm"
            ],
            "matchUpdateTypes": [
                "lockFileMaintenance"
            ],
            "enabled": false
        },
        {
            "description": "Group non-major GitHub Actions version and pin updates",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pinDigest"
            ],
            "groupName": "github-actions"
        },
        {
            "description": "Require manual handling for major updates",
            "matchUpdateTypes": [
                "major"
            ],
            "dependencyDashboardApproval": true
        },
        {
            // Digest refreshes keep already-pinned GitHub Actions pointing at the
            // current commit behind their version tags. They are intentionally kept
            // separate from version bumps so this narrow update type can automerge.
            "description": "Automerge only GitHub Action digest pin refreshes",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "digest"
            ],
            "groupName": "github-action digests",
            "automerge": true
        }
    ]
}
